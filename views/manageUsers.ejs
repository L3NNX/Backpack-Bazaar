<%- include('./partials/header') %>

<% if(success && success.length > 0){ %>
<div class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 bg-gold text-noir text-xs font-bold tracking-widest uppercase rounded-sm">
    <%= success %>
</div>
<% } %>

<div class="flex min-h-screen bg-noir">

    <!-- SIDEBAR -->
    <aside class="w-56 flex-shrink-0 border-r border-noir-border pt-10 px-6">
        <h4 class="text-[9px] font-semibold text-dim-400 tracking-[0.2em] uppercase mb-6">Admin</h4>

        <nav class="flex flex-col gap-1">
            <a href="/owners/admin"
               class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card transition">
                <i class="ri-add-circle-line text-sm"></i>
                Create Product
            </a>

            <a href="/owners/products"
               class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card transition">
                <i class="ri-box-3-line text-sm"></i>
                All Products
            </a>

            <a href="/owners/users"
               class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm bg-gold/10 text-gold border border-gold/20">
                <i class="ri-team-line text-sm"></i>
                Manage Users
            </a>

            <a href="/owners/orders"
                class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card transition">
                <i class="ri-receipt-line text-sm"></i>
                Orders
            </a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="flex-1 px-12 py-12">

        <div class="mb-10">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-5 h-px bg-gold"></div>
                <span class="text-[9px] tracking-[0.2em] uppercase text-gold">Admin Panel</span>
            </div>

            <h2 class="font-display font-bold text-dim-100 text-4xl">Manage Users</h2>
            <p class="text-dim-400 text-sm mt-2"><%= users.length %> total users</p>
        </div>

        <!-- TABLE -->
        <div class="max-w-4xl border border-noir-border rounded-md overflow-hidden">

            <table class="w-full text-sm">

                <thead>
                    <tr class="border-b border-noir-border text-dim-400 text-[10px] tracking-[0.12em] uppercase">
                        <th class="px-6 py-4 font-medium text-left">User</th>
                        <th class="px-6 py-4 font-medium text-left">Email</th>
                        <th class="px-6 py-4 font-medium text-left">Role</th>
                        <th class="px-6 py-4 font-medium text-right">Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% users.forEach(function(user) { %>

                    <tr class="border-b border-noir-border hover:bg-noir-card transition">

                        <!-- USER -->
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-sm border border-noir-border flex items-center justify-center text-xs font-bold text-gold">
                                    <%= user.fullname.charAt(0).toUpperCase() %>
                                </div>
                                <span class="text-dim-200 text-sm font-medium"><%= user.fullname %></span>
                            </div>
                        </td>

                        <!-- EMAIL -->
                        <td class="px-6 py-4 text-dim-400 text-sm">
                            <%= user.email %>
                        </td>

                        <!-- ROLE -->
                        <td class="px-6 py-4">
                            <% if(user.role === 'admin') { %>
                                <span class="text-[10px] uppercase tracking-[0.12em] text-gold">Admin</span>
                            <% } else { %>
                                <span class="text-[10px] uppercase tracking-[0.12em] text-dim-400">User</span>
                            <% } %>
                        </td>

                        <!-- ACTION -->
                        <td class="px-6 py-4 text-right">

                            <% if(user.role === 'user') { %>
                                <form action="/owners/promote/<%= user._id %>" method="POST" class="inline">
                                    <button type="submit"
                                        class="px-3 py-1.5 border border-noir-border text-dim-400 hover:text-gold hover:border-gold/40 text-[10px] uppercase tracking-[0.12em] transition">
                                        Promote
                                    </button>
                                </form>

                            <% } else if(user._id.toString() !== loggedInUser._id.toString()) { %>
                                <form action="/owners/demote/<%= user._id %>" method="POST" class="inline">
                                    <button type="submit"
                                        class="px-3 py-1.5 border border-noir-border text-dim-400 hover:text-red-400 hover:border-red-800/50 text-[10px] uppercase tracking-[0.12em] transition">
                                        Demote
                                    </button>
                                </form>

                            <% } else { %>
                                <span class="text-[10px] text-dim-500 italic">You</span>
                            <% } %>

                        </td>

                    </tr>

                    <% }); %>
                </tbody>

            </table>
        </div>

    </main>
</div>

<%- include('./partials/footer-full') %>