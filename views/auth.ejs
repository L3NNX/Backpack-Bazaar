<%- include('./partials/header') %>

<div class="min-h-screen flex items-center justify-center px-4 py-20">
  <div class="w-full max-w-sm">

    <%# Logo %>
    <div class="text-center mb-10">
      <a href="/" class="font-display text-3xl font-bold tracking-wider text-dim-100">
        JH<span class="text-gold">OLA</span>
      </a>
    </div>

    <%# Tab toggle %>
    <div class="flex border border-noir-border rounded-sm p-0.5 mb-10">
      <button id="loginTab" onclick="showLogin()"
        class="flex-1 py-2.5 text-xs font-semibold tracking-[0.1em] uppercase rounded-sm transition-all duration-200 bg-noir-card text-dim-100">
        Login
      </button>
      <button id="signupTab" onclick="showSignup()"
        class="flex-1 py-2.5 text-xs font-semibold tracking-[0.1em] uppercase rounded-sm transition-all duration-200 text-dim-400">
        Sign Up
      </button>
    </div>

    <%# ── LOGIN FORM ── %>
    <div id="loginForm" class="block">
      <div class="mb-8">
        <h2 class="font-display text-3xl font-bold text-dim-100 mb-1">Welcome Back</h2>
        <p class="text-dim-400 text-sm">Login to access your account</p>
      </div>

      <form autocomplete="off" action="/user/login" method="post" class="space-y-5">

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Email Address</label>
          <div class="relative">
            <i class="ri-mail-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="email" name="email" placeholder="you@example.com" required
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Password</label>
          <div class="relative">
            <i class="ri-lock-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="password" name="password" placeholder="••••••••" required
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-xs text-dim-400 cursor-pointer">
            <input type="checkbox" class="w-3.5 h-3.5 accent-gold">
            Remember me
          </label>
          <a href="#" class="text-xs text-gold hover:text-gold-light transition-colors duration-200">Forgot password?</a>
        </div>

        <button type="submit"
          class="w-full py-3.5 bg-gold hover:bg-gold-light text-noir text-xs font-bold tracking-[0.12em] uppercase rounded-sm transition-all duration-200 hover:scale-[1.01] flex items-center justify-center gap-2">
          <i class="ri-login-box-line text-sm"></i> Login
        </button>

      </form>

      <p class="text-center text-xs text-dim-400 mt-6">
        Don't have an account?
        <button onclick="showSignup()" class="text-gold hover:text-gold-light transition-colors duration-200 font-medium ml-1">Sign up</button>
      </p>
    </div>

    <%# ── SIGNUP FORM ── %>
    <div id="signupForm" class="hidden">
      <div class="mb-8">
        <h2 class="font-display text-3xl font-bold text-dim-100 mb-1">Create Account</h2>
        <p class="text-dim-400 text-sm">Join Jhola and start shopping</p>
      </div>

      <form autocomplete="off" action="/user/register" method="post" class="space-y-5">

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Full Name</label>
          <div class="relative">
            <i class="ri-user-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="text" name="fullname" placeholder="John Doe" required
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Email Address</label>
          <div class="relative">
            <i class="ri-mail-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="email" name="email" placeholder="you@example.com" required
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Password</label>
          <div class="relative">
            <i class="ri-lock-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="password" name="password" placeholder="••••••••" required
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <button type="submit"
          class="w-full py-3.5 bg-gold hover:bg-gold-light text-noir text-xs font-bold tracking-[0.12em] uppercase rounded-sm transition-all duration-200 hover:scale-[1.01] flex items-center justify-center gap-2">
          <i class="ri-user-add-line text-sm"></i> Create Account
        </button>

      </form>

      <p class="text-[10px] text-dim-400 mt-5 text-center leading-relaxed">
        By signing up, you agree to our
        <a href="#" class="text-gold hover:text-gold-light transition-colors duration-200">Terms</a> and
        <a href="#" class="text-gold hover:text-gold-light transition-colors duration-200">Privacy Policy</a>
      </p>

      <p class="text-center text-xs text-dim-400 mt-5">
        Already have an account?
        <button onclick="showLogin()" class="text-gold hover:text-gold-light transition-colors duration-200 font-medium ml-1">Login</button>
      </p>
    </div>

    <%# Divider with brand line %>
    <div class="flex items-center gap-4 mt-12">
      <div class="flex-1 h-px bg-noir-border"></div>
      <span class="text-[9px] tracking-[0.2em] uppercase text-dim-400">Jhola</span>
      <div class="flex-1 h-px bg-noir-border"></div>
    </div>

  </div>
</div>

<script>
  function showLogin() {
    document.getElementById('loginForm').classList.remove('hidden');
    document.getElementById('loginForm').classList.add('block');
    document.getElementById('signupForm').classList.add('hidden');
    document.getElementById('signupForm').classList.remove('block');
    document.getElementById('loginTab').classList.add('bg-noir-card','text-dim-100');
    document.getElementById('loginTab').classList.remove('text-dim-400');
    document.getElementById('signupTab').classList.remove('bg-noir-card','text-dim-100');
    document.getElementById('signupTab').classList.add('text-dim-400');
  }

  function showSignup() {
    document.getElementById('signupForm').classList.remove('hidden');
    document.getElementById('signupForm').classList.add('block');
    document.getElementById('loginForm').classList.add('hidden');
    document.getElementById('loginForm').classList.remove('block');
    document.getElementById('signupTab').classList.add('bg-noir-card','text-dim-100');
    document.getElementById('signupTab').classList.remove('text-dim-400');
    document.getElementById('loginTab').classList.remove('bg-noir-card','text-dim-100');
    document.getElementById('loginTab').classList.add('text-dim-400');
  }

  window.onload = function() {
    if (window.location.hash === '#signup') showSignup();
  }
</script>

<%- include('./partials/footer-minimal') %>
