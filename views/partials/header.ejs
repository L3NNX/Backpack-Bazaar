<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jhola</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>

<body class="bg-white text-zinc-800">
    <nav class="w-full flex justify-between items-center px-8 py-4 border-b border-zinc-100 sticky top-0 bg-white z-50">
        <a href="/" class="text-2xl font-bold tracking-tight text-zinc-900">Jhola</a>
        
        <% if(locals.loggedInUser) { %>
        <div class="flex gap-6 text-sm font-medium items-center">
            <a href="/shop" class="text-zinc-600 hover:text-zinc-900 transition-colors">Shop</a>
            <a href="/cart" class="text-zinc-600 hover:text-zinc-900 transition-colors flex items-center gap-1">
                <i class="ri-shopping-cart-line"></i> Cart
            </a>
            <a href="/profile" class="text-zinc-600 hover:text-zinc-900 transition-colors flex items-center gap-1">
                <i class="ri-user-line"></i> Profile
            </a>
            <a href="/logout" class="px-4 py-1.5 bg-red-50 text-red-600 rounded-full hover:bg-red-100 transition-colors text-xs font-semibold">
                Logout
            </a>
        </div>
        <% } else { %>
        <div class="flex gap-4 text-sm font-medium items-center">
            <a href="/auth" class="text-zinc-600 hover:text-zinc-900 transition-colors">Login</a>
            <a href="/auth" class="px-5 py-2 bg-zinc-900 hover:bg-zinc-700 text-white rounded-full transition">
                Sign Up
            </a>
        </div>
        <% } %>
    </nav>
</body>

</html>