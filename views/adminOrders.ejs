<%- include('./partials/header') %>

<div class="flex min-h-screen bg-noir">

  <!-- SIDEBAR -->
  <aside class="w-56 flex-shrink-0 border-r border-noir-border pt-10 px-6">
    <h4 class="text-[9px] font-semibold text-dim-400 tracking-[0.2em] uppercase mb-6">Admin</h4>

    <nav class="flex flex-col gap-1">
      <a href="/owners/admin" class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card">
        <i class="ri-add-circle-line text-sm"></i> Create Product
      </a>

      <a href="/owners/products" class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card">
        <i class="ri-box-3-line text-sm"></i> All Products
      </a>

      <a href="/owners/users" class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card">
        <i class="ri-team-line text-sm"></i> Users
      </a>

      <a href="/owners/orders" class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm bg-gold/10 text-gold border border-gold/20">
        <i class="ri-receipt-line text-sm"></i> Orders
      </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <main class="flex-1 px-10 py-12">

    <!-- HEADER -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-5 h-px bg-gold"></div>
        <span class="text-[9px] tracking-[0.2em] uppercase text-gold">Admin Panel</span>
      </div>

      <h1 class="font-display font-bold text-dim-100 text-3xl">All Orders</h1>
      <p class="text-dim-400 text-sm mt-2"><%= orders.length %> total orders</p>
    </div>

    <% if(!orders || orders.length === 0) { %>

      <!-- EMPTY -->
      <div class="flex flex-col items-center justify-center h-64 text-dim-400">
        <p class="text-sm mb-4">No orders found</p>
      </div>

    <% } else { %>

      <div class="space-y-5">

        <% orders.forEach(order => { %>

          <div class="bg-noir-card border border-noir-border rounded-md overflow-hidden hover:border-gold/20 transition">

            <!-- ORDER HEADER -->
            <div class="px-6 py-4 border-b border-noir-border flex justify-between items-center flex-wrap gap-4">

              <div class="flex items-center gap-6 flex-wrap">

                <!-- ID -->
                <div>
                  <div class="text-[9px] text-dim-400 uppercase mb-1">Order</div>
                  <div class="text-xs text-dim-200 font-mono">#<%= order._id.toString().slice(-8) %></div>
                </div>

                <!-- USER -->
                <div>
                  <div class="text-[9px] text-dim-400 uppercase mb-1">User</div>
                  <div class="text-xs text-dim-200"><%= order.user?.email || 'N/A' %></div>
                </div>

                <!-- DATE -->
                <div>
                  <div class="text-[9px] text-dim-400 uppercase mb-1">Date</div>
                  <div class="text-xs text-dim-200">
                    <%= new Date(order.createdAt).toLocaleDateString('en-IN') %>
                  </div>
                </div>

                <!-- TOTAL -->
                <div>
                  <div class="text-[9px] text-dim-400 uppercase mb-1">Total</div>
                  <div class="font-display text-gold text-sm font-bold">₹<%= order.total %></div>
                </div>

              </div>

              <!-- STATUS BADGE -->
              <%
                const map = {
                  pending: 'text-yellow-400 border-yellow-400/30',
                  shipped: 'text-blue-400 border-blue-400/30',
                  delivered: 'text-green-400 border-green-400/30',
                  cancelled: 'text-red-400 border-red-400/30'
                };
              %>

              <span class="text-[10px] px-3 py-1 border rounded-sm uppercase tracking-widest <%= map[order.status] || map.pending %>">
                <%= order.status %>
              </span>

            </div>

            <!-- ITEMS -->
            <div class="px-6 py-4 space-y-3">

              <% order.items.forEach(item => { %>

                <div class="flex items-center gap-4">

                  <img src="data:image/webp;base64,<%= item.image.toString('base64') %>"
                       class="w-14 h-14 object-cover rounded-sm border border-noir-border">
                  <div class="flex-1">
                    <p class="text-dim-200 text-sm"><%= item.name %></p>
                    <p class="text-dim-400 text-xs">₹<%= item.price %></p>
                  </div>

                </div>

              <% }) %>

            </div>

            <!-- FOOTER -->
            <div class="px-6 py-4 border-t border-noir-border flex justify-between items-center flex-wrap gap-4">

              <!-- ADDRESS -->
              <div class="text-[10px] text-dim-400">
                <i class="ri-map-pin-line text-gold/60 mr-1"></i>
                <%= order.address || 'No address' %>
              </div>

              <!-- STATUS CONTROL -->
              <form action="/owners/orders/<%= order._id %>/status" method="POST" class="flex items-center gap-2">

                <select name="status"
                  class="bg-noir-card border border-noir-border text-dim-200 text-xs px-3 py-2 rounded-sm focus:outline-none focus:border-gold/40">

                  <option value="pending" <%= order.status==='pending'?'selected':'' %>>Pending</option>
                  <option value="shipped" <%= order.status==='shipped'?'selected':'' %>>Shipped</option>
                  <option value="delivered" <%= order.status==='delivered'?'selected':'' %>>Delivered</option>
                  <option value="cancelled" <%= order.status==='cancelled'?'selected':'' %>>Cancelled</option>

                </select>

                <button type="submit"
                  class="px-4 py-2 bg-gold text-noir text-[10px] font-bold uppercase tracking-widest rounded-sm hover:bg-gold-light">
                  Update
                </button>

              </form>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </main>
</div>

<%- include('./partials/footer-full') %>