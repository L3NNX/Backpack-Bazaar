<%- include('./partials/header') %>

<% if(success && success.length> 0){ %>
<div class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 bg-gold text-noir text-xs font-bold tracking-widest uppercase rounded-sm">
    <%= success %>
</div>
<% } %>

<!-- Delete Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center">
  <div class="absolute inset-0 bg-noir/80 backdrop-blur-sm"
    onclick="document.getElementById('deleteModal').classList.add('hidden'); document.getElementById('deleteModal').classList.remove('flex');"></div>

  <div class="relative bg-noir-card border border-noir-border rounded-md p-6 w-full max-w-sm mx-4">
    <h3 class="font-display text-lg text-dim-100 text-center mb-2">Delete Product?</h3>
    <p class="text-dim-400 text-xs text-center mb-6">This action cannot be undone.</p>

    <div class="flex gap-3">
      <button onclick="document.getElementById('deleteModal').classList.add('hidden'); document.getElementById('deleteModal').classList.remove('flex');"
        class="flex-1 py-2.5 border border-noir-border text-dim-400 hover:text-dim-100 text-xs uppercase">
        Cancel
      </button>
      <button id="confirmDeleteBtn"
        class="flex-1 py-2.5 bg-red-900/40 border border-red-800/40 text-red-300 text-xs uppercase flex items-center justify-center gap-2">
        Delete
      </button>
    </div>
  </div>
</div>

<div class="flex min-h-screen bg-noir">

  <!-- SIDEBAR -->
  <aside class="w-56 flex-shrink-0 border-r border-noir-border pt-10 px-6">
    <h4 class="text-[9px] font-semibold text-dim-400 tracking-[0.2em] uppercase mb-6">Admin</h4>

    <nav class="flex flex-col gap-1">
      <a href="/owners/admin"
        class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card">
        <i class="ri-add-circle-line text-sm"></i>
        Create Product
      </a>

      <a href="/owners/products"
        class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm bg-gold/10 text-gold border border-gold/20">
        <i class="ri-box-3-line text-sm"></i>
        All Products
      </a>

      <a href="/owners/users"
        class="flex items-center gap-2.5 text-xs py-2.5 px-3 rounded-sm text-dim-400 hover:text-dim-200 hover:bg-noir-card">
        <i class="ri-team-line text-sm"></i>
        Manage Users
      </a>
    </nav>

    <!-- STATS -->
    <div class="mt-8 pt-8 border-t border-noir-border">
      <h4 class="text-[9px] font-semibold text-dim-400 tracking-[0.2em] uppercase mb-4">Stats</h4>

      <div class="space-y-3 text-xs text-dim-400">
        <div class="flex justify-between">
          <span>Total Products</span>
          <span class="text-dim-100 font-medium"><%= products.length %></span>
        </div>
        <div class="flex justify-between">
          <span>Discounted</span>
          <span class="text-dim-100 font-medium"><%= products.filter(p=>p.discount>0).length %></span>
        </div>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="flex-1 px-12 py-12">

    <div class="flex items-end justify-between mb-10">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <div class="w-5 h-px bg-gold"></div>
          <span class="text-[9px] tracking-[0.2em] uppercase text-gold">Admin</span>
        </div>
        <h1 class="font-display font-bold text-dim-100 text-3xl">All Products</h1>
      </div>

      <a href="/owners/admin"
        class="px-6 py-3 bg-gold text-noir text-xs font-bold tracking-[0.12em] uppercase rounded-sm">
        Add Product
      </a>
    </div>

    <% if(products.length===0) { %>
    <div class="flex flex-col items-center justify-center h-64 text-dim-400">
      <p class="text-sm mb-4">No products yet</p>
      <a href="/owners/admin"
        class="px-6 py-3 bg-gold text-noir text-xs uppercase tracking-widest rounded-sm">
        Create Product
      </a>
    </div>
    <% } else { %>

    <div class="border border-noir-border rounded-md overflow-hidden">
      <table class="w-full text-sm">

        <thead>
          <tr class="border-b border-noir-border text-[10px] text-dim-400 uppercase tracking-[0.12em]">
            <th class="px-6 py-4 text-left">Product</th>
            <th class="px-6 py-4 text-left">Price</th>
            <th class="px-6 py-4 text-left">Discount</th>
            <th class="px-6 py-4 text-left">Final</th>
            <th class="px-6 py-4 text-left">Colors</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% products.forEach(function(product){ %>

          <tr class="border-b border-noir-border hover:bg-noir-card transition"
              id="product-row-<%= product._id %>">

            <td class="px-6 py-4">
              <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-sm overflow-hidden border border-noir-border">
                  <img class="w-full h-full object-cover"
                    src="data:image/jpeg;base64,<%= product.image.toString('base64') %>">
                </div>
                <div>
                  <h3 class="text-dim-200 text-sm font-medium"><%= product.name %></h3>
                  <p class="text-[10px] text-dim-500 mt-1">ID: <%= product._id.toString().slice(-6) %></p>
                </div>
              </div>
            </td>

            <td class="px-6 py-4 text-dim-400">₹<%= product.price %></td>

            <td class="px-6 py-4">
              <% if(product.discount>0){ %>
                <span class="text-gold text-xs"><%= product.discount %>%</span>
              <% } else { %>
                <span class="text-dim-500 text-xs">—</span>
              <% } %>
            </td>

            <td class="px-6 py-4 text-dim-100 font-medium">
              ₹<%= product.discount>0 ? Math.round(product.price-(product.price*product.discount/100)) : product.price %>
            </td>

            <td class="px-6 py-4">
              <div class="flex gap-1.5">
                <div class="w-5 h-5 border border-noir-border" style="background:<%= product.bgcolor||'#111' %>"></div>
                <div class="w-5 h-5 border border-noir-border" style="background:<%= product.panelcolor||'#0d0d0d' %>"></div>
                <div class="w-5 h-5 border border-noir-border" style="background:<%= product.textcolor||'#ccc' %>"></div>
              </div>
            </td>

            <td class="px-6 py-4 text-right">
              <div class="flex justify-end gap-2">
                <a href="/products/edit/<%= product._id %>"
                  class="w-8 h-8 flex items-center justify-center border border-noir-border text-dim-400 hover:text-gold">
                  ✎
                </a>
                <button onclick="openDeleteModal('<%= product._id %>')"
                  class="w-8 h-8 flex items-center justify-center border border-noir-border text-dim-400 hover:text-red-400">
                  ✕
                </button>
              </div>
            </td>

          </tr>

          <% }) %>
        </tbody>

      </table>
    </div>

    <% } %>
  </main>
</div>

<script>
let deleteProductId = null;

function openDeleteModal(id){
  deleteProductId = id;
  document.getElementById('deleteModal').classList.remove('hidden');
  document.getElementById('deleteModal').classList.add('flex');
}

document.getElementById('confirmDeleteBtn').onclick = async ()=>{
  if(!deleteProductId) return;

  const res = await fetch(`/products/delete/${deleteProductId}`,{method:'DELETE'});
  const data = await res.json();

  if(data.success){
    document.getElementById(`product-row-${deleteProductId}`)?.remove();
  }

  document.getElementById('deleteModal').classList.add('hidden');
  document.getElementById('deleteModal').classList.remove('flex');
};
</script>

<%- include('./partials/footer-full') %>