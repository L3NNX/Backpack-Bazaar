<%- include('./partials/header-landing') %>

<% if(success && success.length > 0){ %>
<div class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-lg bg-green-500 text-white shadow-lg text-sm font-medium">
    <%= success %>
</div>
<% } %>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" 
         onclick="document.getElementById('deleteModal').classList.add('hidden'); document.getElementById('deleteModal').classList.remove('flex');"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl p-6 mx-4 w-full max-w-sm">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
            <i class="ri-delete-bin-line text-3xl text-red-500"></i>
        </div>
        <h3 class="text-xl font-bold text-zinc-900 text-center mb-2">Delete Product?</h3>
        <p class="text-zinc-500 text-center text-sm mb-6">
            Are you sure you want to delete this product? This action cannot be undone.
        </p>
        <div class="flex gap-3">
            <button onclick="document.getElementById('deleteModal').classList.add('hidden'); document.getElementById('deleteModal').classList.remove('flex');" 
                    class="flex-1 py-3 px-4 border border-zinc-200 rounded-xl text-zinc-700 font-medium hover:bg-zinc-50 transition text-sm">
                Cancel
            </button>
            <button id="confirmDeleteBtn" 
                    class="flex-1 py-3 px-4 bg-red-500 hover:bg-red-600 rounded-xl text-white font-medium text-center transition text-sm flex items-center justify-center gap-2">
                <i class="ri-delete-bin-line"></i>
                Delete
            </button>
        </div>
    </div>
</div>

<div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="w-60 flex-shrink-0 border-r border-zinc-100 pt-10 px-6">
        <h4 class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-4">Admin</h4>
        <nav class="flex flex-col gap-2 text-sm text-zinc-600">
            <a class="hover:text-zinc-900 transition" href="/owners/admin">Create Product</a>
            <a class="hover:text-zinc-900 transition font-medium text-blue-600" href="/owners/products">All Products</a>
            <a class="hover:text-zinc-900 transition" href="/owners/users">Manage Users</a>
        </nav>

        <div class="mt-8 pt-8 border-t border-zinc-100">
            <h4 class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-4">Quick Stats</h4>
            <div class="space-y-3">
                <div class="flex items-center justify-between text-sm">
                    <span class="text-zinc-500">Total Products</span>
                    <span class="font-semibold text-zinc-900"><%= products.length %></span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="text-zinc-500">Discounted</span>
                    <span class="font-semibold text-zinc-900"><%= products.filter(p => p.discount > 0).length %></span>
                </div>
            </div>
        </div>
    </aside>

    <!-- Products Listing -->
    <main class="flex-1 px-10 py-10">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-zinc-900">All Products</h1>
                <p class="text-sm text-zinc-400 mt-1">Manage your product catalog</p>
            </div>
            <a href="/owners/admin" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl transition text-sm flex items-center gap-2">
                <i class="ri-add-line"></i>
                Add Product
            </a>
        </div>

        <% if(products.length === 0) { %>
        <div class="flex flex-col items-center justify-center h-64 text-zinc-400">
            <i class="ri-box-3-line text-5xl mb-4"></i>
            <p class="text-sm mb-4">No products yet. Start by creating one!</p>
            <a href="/owners/admin" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl transition text-sm">
                Create Product
            </a>
        </div>
        <% } else { %>

        <!-- Table View -->
        <div class="bg-white rounded-2xl border border-zinc-100 overflow-hidden shadow-sm">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-zinc-100 bg-zinc-50/50">
                        <th class="text-left text-xs font-semibold text-zinc-400 uppercase tracking-widest px-6 py-4">Product</th>
                        <th class="text-left text-xs font-semibold text-zinc-400 uppercase tracking-widest px-6 py-4">Price</th>
                        <th class="text-left text-xs font-semibold text-zinc-400 uppercase tracking-widest px-6 py-4">Discount</th>
                        <th class="text-left text-xs font-semibold text-zinc-400 uppercase tracking-widest px-6 py-4">Final Price</th>
                        <th class="text-left text-xs font-semibold text-zinc-400 uppercase tracking-widest px-6 py-4">Colors</th>
                        <th class="text-right text-xs font-semibold text-zinc-400 uppercase tracking-widest px-6 py-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(function(product){ %>
                    <tr class="border-b border-zinc-50 hover:bg-zinc-50/50 transition" id="product-row-<%= product._id %>">
                        <!-- Product Info -->
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-xl overflow-hidden flex-shrink-0 border border-zinc-100">
                                    <img class="h-full w-full object-cover" 
                                         src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" 
                                         alt="<%= product.name %>">
                                </div>
                                <div>
                                    <h3 class="font-semibold text-sm text-zinc-900"><%= product.name %></h3>
                                    <p class="text-xs text-zinc-400 mt-0.5">ID: <%= product._id.toString().slice(-6) %></p>
                                </div>
                            </div>
                        </td>

                        <!-- Price -->
                        <td class="px-6 py-4">
                            <span class="text-sm font-medium text-zinc-700">&#8377;<%= product.price %></span>
                        </td>

                        <!-- Discount -->
                        <td class="px-6 py-4">
                            <% if(product.discount > 0) { %>
                            <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full font-medium"><%= product.discount %>% off</span>
                            <% } else { %>
                            <span class="text-xs text-zinc-400">—</span>
                            <% } %>
                        </td>

                        <!-- Final Price -->
                        <td class="px-6 py-4">
                            <% if(product.discount > 0) { %>
                            <span class="text-sm font-bold text-zinc-900">&#8377;<%= Math.round(product.price - (product.price * product.discount / 100)) %></span>
                            <% } else { %>
                            <span class="text-sm font-bold text-zinc-900">&#8377;<%= product.price %></span>
                            <% } %>
                        </td>

                        <!-- Colors -->
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-1.5">
                                <div class="w-6 h-6 rounded-full border border-zinc-200 shadow-sm" 
                                     style="background-color: <%= product.bgcolor || '#f4f4f5' %>" 
                                     title="BG: <%= product.bgcolor || '#f4f4f5' %>"></div>
                                <div class="w-6 h-6 rounded-full border border-zinc-200 shadow-sm" 
                                     style="background-color: <%= product.panelcolor || '#ffffff' %>" 
                                     title="Panel: <%= product.panelcolor || '#ffffff' %>"></div>
                                <div class="w-6 h-6 rounded-full border border-zinc-200 shadow-sm" 
                                     style="background-color: <%= product.textcolor || '#1a1a1a' %>" 
                                     title="Text: <%= product.textcolor || '#1a1a1a' %>"></div>
                            </div>
                        </td>

                        <!-- Actions -->
                        <td class="px-6 py-4 text-right">
                            <button onclick="openDeleteModal('<%= product._id %>')"
                                    class="w-9 h-9 inline-flex items-center justify-center rounded-full bg-red-50 hover:bg-red-100 text-red-500 transition-transform hover:scale-110"
                                    title="Delete Product">
                                <i class="ri-delete-bin-line"></i>
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <% } %>
    </main>
</div>

<script>
    let deleteProductId = null;

    function openDeleteModal(productId) {
        deleteProductId = productId;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.getElementById('deleteModal').classList.add('flex');
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
        if (!deleteProductId) return;

        try {
            const res = await fetch(`/products/delete/${deleteProductId}`, {
                method: 'DELETE',
            });
            const data = await res.json();

            if (data.success) {
                // Remove the row from the table
                const row = document.getElementById(`product-row-${deleteProductId}`);
                if (row) row.remove();

                // Close modal
                document.getElementById('deleteModal').classList.add('hidden');
                document.getElementById('deleteModal').classList.remove('flex');

                // Show success flash
                const flash = document.createElement('div');
                flash.className = 'fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-lg bg-green-500 text-white shadow-lg text-sm font-medium';
                flash.textContent = 'Product deleted successfully!';
                document.body.appendChild(flash);
                setTimeout(() => flash.remove(), 3000);
            } else {
                alert('Failed to delete product.');
            }
        } catch (err) {
            alert('Error deleting product.');
        }

        deleteProductId = null;
    });
</script>

<%- include('./partials/footer') %>