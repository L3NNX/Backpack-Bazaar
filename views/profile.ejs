<%- include('./partials/header') %>

<% if(success && success.length > 0){ %>
<div class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 bg-gold text-noir text-xs font-bold tracking-widest uppercase rounded-sm">
    <%= success %>
</div>
<% } %>

<% if(error && error.length > 0){ %>
<div class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 bg-red-900/40 text-red-300 text-xs font-medium tracking-wide uppercase rounded-sm border border-red-800/40">
    <%= error %>
</div>
<% } %>

<div class="max-w-md mx-auto px-6 py-16 min-h-screen bg-noir">

    <!-- Back -->
    <a href="/shop"
       class="inline-flex items-center gap-2 text-[10px] tracking-[0.12em] uppercase text-dim-400 hover:text-gold mb-10">
        ← Back
    </a>

    <!-- Avatar + Info -->
    <div class="flex items-center gap-4 mb-12">
        <div class="w-14 h-14 rounded-sm border border-noir-border flex items-center justify-center text-gold font-bold text-lg">
            <%= user.fullname.charAt(0).toUpperCase() %>
        </div>

        <div>
            <h1 class="font-display text-2xl text-dim-100"><%= user.fullname %></h1>
            <p class="text-xs text-dim-400 mt-1"><%= user.email %></p>

            <% if(user.role === 'admin') { %>
            <span class="text-[9px] uppercase tracking-[0.15em] text-gold mt-1 inline-block">Admin</span>
            <% } %>
        </div>
    </div>

    <!-- Profile -->
    <form action="/profile/update" method="post" class="space-y-4 mb-10">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-4 h-px bg-gold"></div>
            <span class="text-[9px] uppercase tracking-[0.2em] text-gold">Profile</span>
        </div>

        <input type="text" name="fullname" value="<%= user.fullname %>" required
            class="w-full bg-noir-card border border-noir-border text-dim-200 text-sm px-4 py-3 rounded-sm focus:outline-none focus:border-gold/50">

        <input type="email" name="email" value="<%= user.email %>" required
            class="w-full bg-noir-card border border-noir-border text-dim-200 text-sm px-4 py-3 rounded-sm focus:outline-none focus:border-gold/50">

        <button type="submit"
            class="w-full py-3.5 bg-gold text-noir text-xs font-bold tracking-[0.12em] uppercase rounded-sm">
            Save Changes
        </button>
    </form>

    <!-- Password -->
    <form action="/profile/password" method="post" class="space-y-4 mb-10">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-4 h-px bg-gold"></div>
            <span class="text-[9px] uppercase tracking-[0.2em] text-gold">Password</span>
        </div>

        <input type="password" name="currentPassword" required
            class="w-full bg-noir-card border border-noir-border text-dim-200 text-sm px-4 py-3 rounded-sm focus:outline-none focus:border-gold/50">

        <input type="password" name="newPassword" required
            class="w-full bg-noir-card border border-noir-border text-dim-200 text-sm px-4 py-3 rounded-sm focus:outline-none focus:border-gold/50">

        <button type="submit"
            class="w-full py-3.5 border border-noir-border text-dim-400 hover:text-dim-100 text-xs uppercase tracking-[0.1em] rounded-sm">
            Update Password
        </button>
    </form>

    <!-- Links -->
    <div class="space-y-2 mb-10">

        <a href="/cart"
           class="flex items-center justify-between px-4 py-3 border border-noir-border rounded-sm hover:border-gold/30 transition">
            <span class="text-xs text-dim-200">Cart</span>
            <span class="text-[10px] text-dim-400"><%= user.cart.length %></span>
        </a>

        <a href="/shop"
           class="flex items-center justify-between px-4 py-3 border border-noir-border rounded-sm hover:border-gold/30 transition">
            <span class="text-xs text-dim-200">Shop</span>
            →
        </a>

    </div>

    <!-- Logout -->
    <a href="/logout"
       class="flex items-center justify-center gap-2 text-xs text-red-400 hover:text-red-300 uppercase tracking-[0.12em]">
        Logout
    </a>

</div>

<%- include('./partials/footer-full') %>