<%- include('./partials/header') %>

<% if(success && success.length > 0){ %>
<div class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-lg bg-green-500 text-white shadow-lg text-sm font-medium">
    <%= success %>
</div>
<% } %>

<% if(error && error.length > 0){ %>
<div class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-lg bg-red-500 text-white shadow-lg text-sm font-medium">
    <%= error %>
</div>
<% } %>

<div class="max-w-md mx-auto px-6 py-16 min-h-screen">

    <!-- Back -->
    <a href="/shop" class="inline-flex items-center gap-1 text-sm text-zinc-400 hover:text-zinc-900 transition mb-10">
        <i class="ri-arrow-left-s-line text-lg"></i> Back
    </a>

    <!-- Avatar + Info -->
    <div class="flex items-center gap-4 mb-10">
        <div class="w-16 h-16 rounded-full flex items-center justify-center
            <% if(user.role === 'admin') { %> bg-blue-50 <% } else { %> bg-zinc-100 <% } %>">
            <span class="text-2xl font-bold
                <% if(user.role === 'admin') { %> text-blue-600 <% } else { %> text-zinc-400 <% } %>">
                <%= user.fullname.charAt(0).toUpperCase() %>
            </span>
        </div>
        <div>
            <h1 class="text-xl font-bold text-zinc-900"><%= user.fullname %></h1>
            <p class="text-sm text-zinc-400"><%= user.email %></p>
            <% if(user.role === 'admin') { %>
            <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wide">Admin</span>
            <% } %>
        </div>
    </div>

    <!-- Update Profile -->
    <form action="/profile/update" method="post" class="space-y-4 mb-8">
        <h2 class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-2">Profile</h2>
        <input type="text" name="fullname" value="<%= user.fullname %>" required placeholder="Full Name"
               class="w-full px-4 py-3 bg-zinc-50 border-0 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-zinc-900">
        <input type="email" name="email" value="<%= user.email %>" required placeholder="Email"
               class="w-full px-4 py-3 bg-zinc-50 border-0 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-zinc-900">
        <button type="submit" class="w-full py-3 bg-zinc-900 hover:bg-zinc-700 text-white font-medium rounded-full transition text-sm">
            Save Changes
        </button>
    </form>

    <!-- Change Password -->
    <form action="/profile/password" method="post" class="space-y-4 mb-8">
        <h2 class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-2">Password</h2>
        <input type="password" name="currentPassword" required placeholder="Current password"
               class="w-full px-4 py-3 bg-zinc-50 border-0 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-zinc-900">
        <input type="password" name="newPassword" required placeholder="New password"
               class="w-full px-4 py-3 bg-zinc-50 border-0 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-zinc-900">
        <button type="submit" class="w-full py-3 border border-zinc-200 hover:border-zinc-300 text-zinc-600 font-medium rounded-full transition text-sm">
            Update Password
        </button>
    </form>

    <!-- Quick Links -->
    <div class="space-y-2 mb-8">
        <a href="/cart" class="flex items-center justify-between px-4 py-3 bg-zinc-50 rounded-xl hover:bg-zinc-100 transition">
            <div class="flex items-center gap-3">
                <i class="ri-shopping-cart-2-line text-zinc-400"></i>
                <span class="text-sm text-zinc-700">Cart</span>
            </div>
            <span class="text-xs text-zinc-400"><%= user.cart.length %></span>
        </a>
        <a href="/shop" class="flex items-center justify-between px-4 py-3 bg-zinc-50 rounded-xl hover:bg-zinc-100 transition">
            <div class="flex items-center gap-3">
                <i class="ri-shopping-bag-line text-zinc-400"></i>
                <span class="text-sm text-zinc-700">Shop</span>
            </div>
            <i class="ri-arrow-right-s-line text-zinc-300"></i>
        </a>
    </div>

    <!-- Logout -->
    <a href="/logout" class="flex items-center justify-center gap-2 text-sm text-red-500 hover:text-red-600 transition">
        <i class="ri-logout-box-line"></i>
        Logout
    </a>

</div>

<%- include('./partials/footer') %>