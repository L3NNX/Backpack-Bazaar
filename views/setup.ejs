<%- include('./partials/header') %>

<div class="min-h-screen flex items-center justify-center px-4 py-20">
  <div class="w-full max-w-sm">

    <% if(locals.alreadySetup) { %>

      <%# ── LOCKED STATE ── %>
      <div class="text-center">
        <div class="w-14 h-14 mx-auto mb-6 rounded-sm border border-green-800/40 bg-green-950/30 flex items-center justify-center">
          <i class="ri-check-line text-2xl text-green-400"></i>
        </div>
        <h2 class="font-display text-3xl font-bold text-dim-100 mb-3">Setup Complete</h2>
        <p class="text-dim-400 text-sm mb-8 leading-relaxed">
          An admin account already exists. This page is permanently locked.
        </p>
        <a href="/auth"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-gold hover:bg-gold-light text-noir text-xs font-bold tracking-[0.12em] uppercase rounded-sm transition-all duration-200">
          Go to Login →
        </a>
      </div>

    <% } else { %>

      <%# ── SETUP FORM ── %>

      <%# Header %>
      <div class="text-center mb-10">
        <div class="w-12 h-12 mx-auto mb-5 rounded-sm border border-gold/30 bg-gold/5 flex items-center justify-center">
          <i class="ri-shield-keyhole-line text-xl text-gold"></i>
        </div>
        <h1 class="font-display text-3xl font-bold text-dim-100 mb-2">Initial Setup</h1>
        <p class="text-dim-400 text-sm">Create your admin account to get started.</p>
      </div>

      <%# Error %>
      <% if(locals.error && error.length > 0) { %>
        <div class="flex items-center gap-3 px-4 py-3 mb-6 bg-red-950/30 border border-red-800/40 rounded-sm text-red-300 text-xs">
          <i class="ri-error-warning-line text-sm flex-shrink-0"></i>
          <%= error %>
        </div>
      <% } %>

      <form action="/setup" method="POST" class="space-y-5">

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">
            Setup Secret Key
          </label>
          <div class="relative">
            <i class="ri-key-2-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="password" name="secretKey" required placeholder="From your .env file"
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
          <p class="text-[10px] text-dim-400/60 mt-1.5 tracking-wide">SETUP_SECRET from your environment variables</p>
        </div>

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Full Name</label>
          <div class="relative">
            <i class="ri-user-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="text" name="fullname" required placeholder="Admin Name"
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Email</label>
          <div class="relative">
            <i class="ri-mail-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="email" name="email" required placeholder="admin@store.com"
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-medium tracking-[0.12em] uppercase text-dim-400 mb-2">Password</label>
          <div class="relative">
            <i class="ri-lock-line absolute left-4 top-1/2 -translate-y-1/2 text-dim-400 text-sm"></i>
            <input type="password" name="password" required placeholder="Strong password"
              class="w-full bg-noir-card border border-noir-border text-dim-200 placeholder-dim-400 text-sm pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-gold/50 transition-colors duration-200">
          </div>
        </div>

        <button type="submit"
          class="w-full py-3.5 bg-gold hover:bg-gold-light text-noir text-xs font-bold tracking-[0.12em] uppercase rounded-sm transition-all duration-200 hover:scale-[1.01] flex items-center justify-center gap-2 mt-2">
          <i class="ri-shield-check-line text-sm"></i>
          Create Admin Account
        </button>

      </form>

      <p class="text-center text-[10px] text-dim-400/60 mt-6 leading-relaxed">
        This page locks permanently after the first admin is created.
      </p>

    <% } %>
  </div>
</div>

<%- include('./partials/footer-minimal') %>
