<%- include('./partials/header-landing') %>

<!-- Hero Section -->
<section class="bg-white">
    <div class="max-w-6xl mx-auto px-8 py-24 lg:py-32">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            
            <!-- Left Content -->
            <div class="flex-1 text-center lg:text-left">
                <p class="text-sm font-medium text-zinc-500 mb-4 tracking-wide">
                    NEW COLLECTION 2025
                </p>
                <h1 class="text-4xl lg:text-6xl font-bold text-zinc-900 leading-tight mb-6">
                    Carry Your Style <br> Everywhere
                </h1>
                <p class="text-lg text-zinc-500 mb-8 max-w-md mx-auto lg:mx-0">
                    Premium bags crafted for the modern lifestyle. From work to weekend, we've got you covered.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="/shop" 
                       class="px-8 py-4 bg-zinc-900 hover:bg-zinc-700 text-white font-medium rounded-full transition text-sm inline-flex items-center justify-center gap-2">
                        <i class="ri-shopping-bag-line"></i>
                        Shop Now
                    </a>
                    <a href="/auth" 
                       class="px-8 py-4 border border-zinc-200 hover:border-zinc-300 text-zinc-700 font-medium rounded-full transition text-sm inline-flex items-center justify-center gap-2">
                        Get Started
                    </a>
                </div>
                
                <!-- Stats -->
                <div class="flex items-center gap-10 mt-12 justify-center lg:justify-start">
                    <div>
                        <p class="text-2xl font-bold text-zinc-900">10K+</p>
                        <p class="text-xs text-zinc-400">Customers</p>
                    </div>
                    <div class="w-px h-10 bg-zinc-100"></div>
                    <div>
                        <p class="text-2xl font-bold text-zinc-900">500+</p>
                        <p class="text-xs text-zinc-400">Products</p>
                    </div>
                    <div class="w-px h-10 bg-zinc-100"></div>
                    <div>
                        <p class="text-2xl font-bold text-zinc-900">4.9</p>
                        <p class="text-xs text-zinc-400">Rating</p>
                    </div>
                </div>
            </div>
            
            <!-- Right Image -->
            <div class="flex-1">
                <div class="bg-zinc-50 rounded-3xl p-6 max-w-md mx-auto">
                    <img 
                        src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=500&h=600&fit=crop" 
                        alt="Featured Bag" 
                        class="w-full h-80 object-cover rounded-2xl"
                    >
                    <div class="mt-4 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-zinc-400 mb-1">Bestseller</p>
                            <h3 class="font-semibold text-zinc-900">Premium Leather Tote</h3>
                        </div>
                        <p class="text-lg font-bold text-zinc-900">₹2,499</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-20 border-t border-zinc-100">
    <div class="max-w-6xl mx-auto px-8">
        <div class="text-center mb-16">
            <h2 class="text-2xl lg:text-3xl font-bold text-zinc-900 mb-3">Why Choose Jhola?</h2>
            <p class="text-zinc-500 text-sm max-w-lg mx-auto">
                Quality products with exceptional service
            </p>
        </div>
        
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="text-center">
                <div class="w-12 h-12 mx-auto mb-4 bg-zinc-100 rounded-xl flex items-center justify-center">
                    <i class="ri-truck-line text-xl text-zinc-600"></i>
                </div>
                <h3 class="font-medium text-zinc-900 text-sm mb-1">Free Shipping</h3>
                <p class="text-xs text-zinc-400">On orders above ₹999</p>
            </div>
            
            <div class="text-center">
                <div class="w-12 h-12 mx-auto mb-4 bg-zinc-100 rounded-xl flex items-center justify-center">
                    <i class="ri-shield-check-line text-xl text-zinc-600"></i>
                </div>
                <h3 class="font-medium text-zinc-900 text-sm mb-1">Secure Payments</h3>
                <p class="text-xs text-zinc-400">100% protected</p>
            </div>
            
            <div class="text-center">
                <div class="w-12 h-12 mx-auto mb-4 bg-zinc-100 rounded-xl flex items-center justify-center">
                    <i class="ri-loop-left-line text-xl text-zinc-600"></i>
                </div>
                <h3 class="font-medium text-zinc-900 text-sm mb-1">Easy Returns</h3>
                <p class="text-xs text-zinc-400">30-day policy</p>
            </div>
            
            <div class="text-center">
                <div class="w-12 h-12 mx-auto mb-4 bg-zinc-100 rounded-xl flex items-center justify-center">
                    <i class="ri-customer-service-2-line text-xl text-zinc-600"></i>
                </div>
                <h3 class="font-medium text-zinc-900 text-sm mb-1">24/7 Support</h3>
                <p class="text-xs text-zinc-400">Always here</p>
            </div>
        </div>
    </div>
</section>

